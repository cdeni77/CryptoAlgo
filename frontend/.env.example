# Copy to `frontend/.env` and fill in. `frontend/.env` is gitignored — a token
# committed here is a token in every clone forever, which has already happened
# once in this repository (6097ed1).
VITE_API_BASE_URL=http://localhost:8000

# Must equal API_TOKEN on the backend. Vite inlines every VITE_* variable into
# the client bundle, so this value is public to anyone who can load the page.
# It is a deployment convenience, not a secret — keep the dashboard bound to
# loopback and treat this token as compromised the moment the bundle ships.
VITE_API_TOKEN=
