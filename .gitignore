# ── Generated by the trader pipeline (never commit) ────────────────────────
# Models are produced by training and promoted via live_orchestrator's staging
# directory; the container loads them from the trader_models volume.
backend/trader/models/*.joblib
backend/trader/models/.staging/

# Search output and the Optuna study are run artifacts, not source. The search
# ledger is the durable record.
backend/trader/optimization_results/
backend/trader/scripts/optimization_results/
backend/trader/scripts/optuna_trading.db
backend/trader/scripts/optuna_trading.db.lock
*.db.lock

# Research store (Parquet) is rebuilt from the scraper — except the two datasets
# that cannot be rebuilt at all.
#
# CDE publishes no historical endpoint for funding or open interest. Both are
# snapshots on the product payload, so they accumulate forward at one observation
# per contract per hour and a lost row is lost permanently. Bars re-fetch with
# `run_pipeline --backfill-days 400`; features regenerate from bars.
#
# The sizes make the decision obvious: bars 15M and features 49M, both
# recoverable, against funding 296K and open interest 296K, neither recoverable.
# Under one percent of the store is the irreplaceable part, and about 6MB a year.
# Leaving it to a remembered `git add -f` is how the deep-history partitions went
# missing once already.
!backend/trader/data/
backend/trader/data/*
!backend/trader/data/research/
backend/trader/data/research/*
!backend/trader/data/research/funding/
!backend/trader/data/research/funding/**
!backend/trader/data/research/open_interest/
!backend/trader/data/research/open_interest/**

# Vite/tsc build cache
*.tsbuildinfo

# Node dependencies and the Vite dev-server cache
node_modules/
.vite/

# Generated by `npm run build` (tsc -b on the composite tsconfig.node.json).
# These were tracked, so every build dirtied the tree — and Vite resolves
# vite.config.js BEFORE vite.config.ts, so the committed .js was what actually
# loaded. A failed build in a cold checkout once rewrote vite.config.d.ts to
# `declare const _default: any;` and broke `npm run lint`.
frontend/vite.config.js
frontend/vite.config.d.ts
