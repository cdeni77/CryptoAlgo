# Copy to .env and fill in. `docker compose up` refuses to start without
# POSTGRES_PASSWORD, which is deliberate: the previous compose file carried a
# working password in version control and published Postgres on every interface.

# ── Required ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Exchange ───────────────────────────────────────────────────────────────
# Needed for live data collection and the wallet endpoint. The scraper and the
# research pipeline run without them against whatever is already in the store.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ---- Kalshi (required only for `scripts.live --mode live`) ------------------
# Auth is RSA-PSS over SHA-256 of `timestamp + METHOD + path`, not an HMAC
# secret, so this is a key id plus an RSA private key.
KALSHI_KEY_ID=
# Either paste the PEM here, or point KALSHI_PRIVATE_KEY_PATH at a file holding
# it. The path is usually the better choice: a PEM in an env var is a PEM in
# every process listing.
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_PATH=
# Leave unset for production. A demo host exists for dry runs against real
# market structure without real money.
KALSHI_BASE_URL=
# Series tickers for the 15-minute up/down markets. Individual markets are
# resolved by asking the venue which one closes when the window settles, so a
# series rename fails loudly rather than trading the wrong contract.
KALSHI_SERIES_BTC=KXBTCD
KALSHI_SERIES_ETH=KXETHD
KALSHI_SERIES_SOL=KXSOLD

# ---- optional --------------------------------------------------------------
# Venue fee schedule. Unset still prices correctly — the built-in defaults are
# the published schedule — but records no version in the model's provenance.
FEE_CONFIG=
# Parquet research store root. Absolute, not cwd-relative: `data/research`
# resolved against whatever directory a script started in created a second,
# empty store that simply went unread.
RESEARCH_STORE=
MODELS_ROOT=

# ── API ────────────────────────────────────────────────────────────────────
# Shared secret for POST /research/launch, the one endpoint that starts a
# process — in a container that holds the keys above. Leave it unset and that
# route returns 503; it fails closed rather than running unauthenticated.
# Generate one with:  openssl rand -hex 32
API_TOKEN=

# Comma-separated browser origins allowed to call the API. `*` is filtered out.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Where the browser reaches the API. Must be an address the *browser* can
# resolve, not the Docker-internal hostname.
VITE_API_BASE_URL=http://localhost:8000

# ── Optional ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=trades_db

# Ledger addresses surfaced by the wallet endpoint, as a JSON array.
LEDGER_WALLETS_JSON=[]
