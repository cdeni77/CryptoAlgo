# Copy to .env and fill in. `docker compose up` refuses to start without
# POSTGRES_PASSWORD, which is deliberate: the previous compose file carried a
# working password in version control and published Postgres on every interface.

# ── Required ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Coinbase (the price data) ──────────────────────────────────────────────
# One-minute spot bars for BTC-USD, ETH-USD and SOL-USD. Needed by
# `scripts.scrape` and by the live loop, which fetches the last day of bars each
# cycle. The research scripts run without them against whatever is in the store.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ── Kalshi (the venue) ─────────────────────────────────────────────────────
# Only read by `scripts.live --mode live`. Paper mode never opens a client.
#
# Auth is RSA-PSS over SHA-256 of `timestamp + METHOD + path`, not an HMAC
# secret — so this is a key id plus an RSA private key, not a key/secret pair.
KALSHI_KEY_ID=

# Either paste the PEM here, or point KALSHI_PRIVATE_KEY_PATH at a file holding
# it. Prefer the path: a PEM in an environment variable is a PEM in every
# process listing, and it ends up in `docker inspect` output.
KALSHI_PRIVATE_KEY=
KALSHI_PRIVATE_KEY_PATH=

# Leave unset for production. Kalshi runs a demo host, which is the right place
# to prove the plumbing against real market structure without real money.
KALSHI_BASE_URL=

# Series tickers for the 15-minute up/down markets. These defaults are
# UNVERIFIED. Individual markets are resolved by asking the venue which one
# closes when the window settles, so a wrong series fails loudly with "no market
# closes within 90s of ..." rather than trading a neighbouring contract — run
# `python -m scripts.check_venue` to find out which is the case.
KALSHI_SERIES_BTC=KXBTCD
KALSHI_SERIES_ETH=KXETHD
KALSHI_SERIES_SOL=KXSOLD

# ── API and dashboard ──────────────────────────────────────────────────────
# Shared secret for POST /jobs/{job}, the one route that starts a process — in a
# container that holds the keys above. Leave it unset and that route returns 503:
# it fails closed rather than running unauthenticated.
# Generate one with:  openssl rand -hex 32
API_TOKEN=

# Must equal API_TOKEN. Vite inlines `import.meta.env.VITE_*` at BUILD time, so
# `docker compose` passes API_TOKEN in as a build argument and this variable is
# only for `npm run dev`. Setting it at runtime on the built bundle reaches
# nothing.
VITE_API_TOKEN=

# Where the browser reaches the API. Must be an address the *browser* can
# resolve, not the Docker-internal hostname. The compose default is `/api`,
# which nginx proxies, so the bundle hardcodes no host at all.
VITE_API_BASE_URL=http://localhost:8000

# Comma-separated browser origins allowed to call the API. `*` is filtered out,
# so listing it alongside real origins does not silently allow everything.
# 5173 is `npm run dev`, 4173 is `npm run preview`, 3000 is the compose frontend.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:4173

# ── Storage ────────────────────────────────────────────────────────────────
# Where the trader's `/app/data` and `/app/models` come from. Named Docker
# volumes by default, because `data/` is gitignored and a bind default would be a
# path Docker creates empty on a clean clone.
#
# Set TRADER_DATA_MOUNT to the host directory if you scraped on the host —
# otherwise the named volume layers on top and the container backfills from
# scratch into a second, invisible copy:
#   TRADER_DATA_MOUNT=./backend/trader/data
TRADER_DATA_MOUNT=
TRADER_MODELS_MOUNT=

# ── Optional ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=trades_db

# Venue fee schedule, by filename, out of backend/trader/configs/venue. Unset
# still prices correctly — the built-in defaults are the published Kalshi
# schedule — but records no schedule version in a model's provenance.
FEE_CONFIG=

# Parquet research store and model roots, when not running under compose.
# Absolute, not cwd-relative: `data/research` resolved against whatever
# directory a script happened to start in created a second, empty store that
# simply went unread.
RESEARCH_STORE=
MODELS_ROOT=
