# Copy to .env and fill in. `docker compose up` refuses to start without
# POSTGRES_PASSWORD, which is deliberate: the previous compose file carried a
# working password in version control and published Postgres on every interface.

# ── Required ───────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=

# ── Exchange ───────────────────────────────────────────────────────────────
# Needed for live data collection and the wallet endpoint. The scraper and the
# research pipeline run without them against whatever is already in the store.
COINBASE_API_KEY=
COINBASE_API_SECRET=

# ── API ────────────────────────────────────────────────────────────────────
# Shared secret for POST /research/launch, the one endpoint that starts a
# process — in a container that holds the keys above. Leave it unset and that
# route returns 503; it fails closed rather than running unauthenticated.
# Generate one with:  openssl rand -hex 32
API_TOKEN=

# Comma-separated browser origins allowed to call the API. `*` is filtered out.
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173

# Where the browser reaches the API. Must be an address the *browser* can
# resolve, not the Docker-internal hostname.
VITE_API_BASE_URL=http://localhost:8000

# ── Optional ───────────────────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_DB=trades_db

# Ledger addresses surfaced by the wallet endpoint, as a JSON array.
LEDGER_WALLETS_JSON=[]
